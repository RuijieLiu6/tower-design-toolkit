      ]
    },
    "modelElement": {
      "type": "object",
      "required": [
        "id",
        "role",
        "name",
        "tags",
        "geometry",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "name": {
          "type": "string"
        },
        "tags": {
          "type": "object",
          "properties": {
            "use": {
              "$ref": "#/$defs/use"
            },
            "level": {
              "type": "number"
            },
            "towerId": {
              "type": "string"
            }
          }
        },
        "geometry": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "mesh",
                "polygon",
                "prism"
              ]
            },
            "bbox": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            },
            "footprint": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            },
            "triangles": {
              "type": "integer",
              "minimum": 0
            },
            "meshId": {
              "type": "string"
            },
            "rings": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                }
              }
            },
            "z": {
              "type": "number"
            },
            "z0": {
              "type": "number"
            },
            "z1": {
              "type": "number"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "mesh"
                  }
                }
              },
              "then": {
                "required": [
                  "bbox",
                  "footprint",
                  "triangles"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "polygon"
                  }
                }
              },
              "then": {
                "required": [
                  "rings",
                  "z"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "prism"
                  }
                }
              },
              "then": {
                "required": [
                  "rings",
                  "z0",
                  "z1"
                ]
              }
            }
          ]
        },
        "provenance": {
          "type": "object",
          "required": [
            "file",
            "format",
            "layer",
            "objectId",
            "objectName",
            "objectType",
            "geometrySource",
            "mappedBy",
            "evidence"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "format": {
              "type": "string"
            },
            "layer": {
              "type": "string"
            },
            "objectId": {
              "type": [
                "string",
                "null"
              ]
            },
            "objectName": {
              "type": "string"
            },
            "objectType": {
              "type": "string"
            },
            "userStrings": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "geometrySource": {
              "type": "string"
            },
            "block": {
              "type": "string"
            },
            "mappedBy": {
              "type": "string"
            },
            "evidence": {
              "enum": [
                "verified",
                "team_assumption",
                "unverified",
                "unresolved",
                "false_assumption"
              ]
            }
          }
        }
      }
    },
    "studySite": {
      "type": "object",
      "description": "Real Vancouver study site (engine/site.ts StudySite, Integrate Vista session, 4 Nov 2026): a 2D ring in the local frame (EPSG:26910 minus the City origin 491300, 5458600), open and counter-clockwise; no vertical datum. Provenance is in source, note, label and parcelLayer.",
      "required": [
        "ring",
        "source",
        "note",
        "label",
        "replaced",
        "keepReplaced",
        "parcelsAdd",
        "parcelsSkip",
        "parcelLayer",
        "areaBasis"
      ],
      "properties": {
        "ring": {
          "type": "array",
          "minItems": 3,
          "maxItems": 1024,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        },
        "source": {
          "enum": [
            "drawn",
            "buildings",
            "parcels",
            "geojson"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 400
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "replaced": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "keepReplaced": {
          "type": "boolean"
        },
        "parcelsAdd": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "parcelsSkip": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "parcelLayer": {
          "type": [
            "string",
            "null"
          ]
        },
        "areaBasis": {
          "enum": [
            "parcels",
            "boundary"
          ]
        }
      }
    }
  }
}
