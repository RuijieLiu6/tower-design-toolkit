      "soft": "background: rgb(255 255 255 / 0.86); art: filter: saturate(0.7);",
      "off": "background: rgb(255 255 255 / 0.6); box-shadow: 0 1px 2px rgb(24 40 34 / 0.08); art: filter: saturate(0.12); opacity: 0.7;",
      "hover": "transform: translateY(-1px); box-shadow: 0 2px 4px rgb(24 40 34 / 0.14), 0 10px 20px -8px rgb(24 40 34 / 0.34);",
      "focus": "box-shadow: 0 0 0 2px #fff, 0 0 0 4px #2563eb, 0 1px 2px rgb(32 38 48 / 0.12), 0 4px 10px -4px rgb(32 38 48 / 0.2);",
      "selected": "box-shadow: 0 0 0 2px #2563eb, 0 6px 14px -6px rgb(24 40 34 / 0.3);"
    },
    "css": [
      {
        "selector": ".node-tile",
        "body": "position: relative; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: var(--nt); height: var(--nt); border-radius: var(--radius-panel); background: #fff; box-shadow: var(--shadow-tile); transition: transform 160ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 160ms, opacity 160ms;"
      },
      {
        "selector": ".node-tile[data-state=\"soft\"]",
        "body": "background: rgb(255 255 255 / 0.86);"
      },
      {
        "selector": ".node-tile[data-state=\"soft\"] svg",
        "body": "filter: saturate(0.7);"
      },
      {
        "selector": ".node-tile[data-state=\"off\"]",
        "body": "background: rgb(255 255 255 / 0.6); box-shadow: 0 1px 2px rgb(24 40 34 / 0.08);"
      },
      {
        "selector": ".node-tile[data-state=\"off\"] svg",
        "body": "filter: saturate(0.12); opacity: 0.7;"
      },
      {
        "selector": ".node-tile[data-state=\"soft\"] img",
        "body": "filter: saturate(0.7);"
      },
      {
        "selector": ".node-tile[data-state=\"off\"] img",
        "body": "filter: saturate(0.12); opacity: 0.7;"
      },
      {
        "selector": ".node-hit:hover .node-tile",
        "body": "transform: translateY(-1px); box-shadow: 0 2px 4px rgb(24 40 34 / 0.14), 0 10px 20px -8px rgb(24 40 34 / 0.34);"
      },
      {
        "selector": ".node-hit",
        "body": "outline: none;"
      },
      {
        "selector": ".node-hit:focus-visible .node-tile",
        "body": "box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--color-focus), var(--shadow-tile);"
      },
      {
        "selector": ".node-hit[data-selected] .node-tile",
        "body": "box-shadow: 0 0 0 2px var(--color-accent), 0 6px 14px -6px rgb(24 40 34 / 0.3);"
      }
    ],
    "note": "Drawn by the platform around every icon (components/NodeTile.tsx). The states live on the clickable element around the tile (.node-hit), never in the artwork."
  },
